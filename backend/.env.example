# PostgreSQL (Production / Cloud)
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
# Example (Supabase):
Imtherealg@at18
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.abcdefghijk.supabase.co:5432/postgres"

# ----------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------
# Allowed origins for the frontend. Use * for development only.
CORS_ORIGINS="*"
# Example for production:
# CORS_ORIGINS="https://your-dca-frontend.vercel.app,https://your-domain.com"
